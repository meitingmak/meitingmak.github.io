---

<Page title="Seminars & Conferences" description="Academic seminars, invited talks, and conference presentations">
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">Seminars & Conferences</h1>
      <p>Selected invited seminars, oral presentations, and conference posters.</p>
    </header>
    <article>
      {
        sections.map((section) => (
          <section class="presentation-section">
            <h2>{section.heading}</h2>
            <div class="presentation-list">
              {section.events.map((event) => (
                <div class="presentation-entry">
                  <div class="presentation-main">
                    <strong>
                      {event.url ? (
                        <a href={event.url} target="_blank" rel="noopener noreferrer">
                          {event.title}
                        </a>
                      ) : (
                        event.title
                      )}
                    </strong>
                    <div class="presentation-venue">{event.venue}</div>
                  </div>
                  <div class="presentation-date">{event.date}</div>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </article>
  </div>
</Page>

<style>
  .presentation-section {
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .presentation-section h2 {
    margin-bottom: 1.25rem;
  }

  .presentation-entry {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .presentation-main {
    flex: 1;
    min-width: 0;
  }

  .presentation-main strong {
    display: block;
    line-height: 1.5;
  }

  .presentation-venue {
    margin-top: 0.4rem;
    color: var(--global-text-color-light);
    font-size: 0.9rem;
  }

  .presentation-date {
    flex-shrink: 0;
    min-width: 110px;
    text-align: right;
    color: var(--global-text-color-light);
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .presentation-entry {
      flex-direction: column;
      gap: 0.4rem;
    }

    .presentation-date {
      text-align: left;
    }
  }
</style>
