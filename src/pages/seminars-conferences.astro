---
import Page from '@layouts/Page.astro';

const seminars = [
  {
    title: 'Your Seminar Presentation Title',
    venue: 'University or Institution, City, Country',
    date: 'June 2026',
  },
];

const conferences = [
  {
    title: 'Your Conference Presentation Title',
    venue: 'Conference Name, City, Country',
    date: 'July 2026',
  },
];
---

<Page title="Seminars & Conferences" description="Invited seminars and conference presentations">
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">Seminars & Conferences</h1>
    </header>
    <article>
      <h2>Invited Seminars</h2>
      {
        seminars.map((event) => (
          <div class="event">
            <strong>{event.title}</strong>
            <div>{event.venue}</div>
            <div class="event-date">{event.date}</div>
          </div>
        ))
      }

      <h2>Conference Presentations</h2>
      {
        conferences.map((event) => (
          <div class="event">
            <strong>{event.title}</strong>
            <div>{event.venue}</div>
            <div class="event-date">{event.date}</div>
          </div>
        ))
      }
    </article>
  </div>
</Page>

<style>
  .event {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .event-date {
    color: var(--global-text-color-light);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }

  h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
</style>
